{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Stash's windows (panel, edge handle, desktop widgets): own commands plus events and theme.",
  "windows": [
    "panel",
    "edge",
    "widget-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-theme",
    "core:window:allow-start-dragging"
  ]
}
