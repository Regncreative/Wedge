{
  "name": "wedge",
  "version": "2.1.0",
  "description": "A file shelf on the edge of your screen",
  "author": "Regncreative",
  "license": "MIT",
  "homepage": "https://wedge.regncreative.com",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Regncreative/Wedge.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:msix": "node scripts/build-msix.mjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build:e2e": "tauri build --debug --no-bundle",
    "test:e2e": "playwright test",
    "test:perf": "playwright test perf",
    "icons": "node scripts/render-icons.mjs",
    "msix:assets": "node scripts/render-msix-assets.mjs",
    "lint": "eslint -c eslint.config.cjs . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vitest": "^2.1.9"
  }
}
